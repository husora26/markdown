<?xml version="1.0" encoding="utf-8"?>
<!-- Keine Cloud-Sicherung und keine Geräteübertragung der App-Daten (Sitzung, Zugangscodes, lokale Hausdaten).
     Husora-Daten sichert der Nutzer über die Husora-Cloud bzw. „Daten exportieren“. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
