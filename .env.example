# Vorlage – kopieren nach .env.beta bzw. .env.production (beide sind in .gitignore).
# NUR öffentliche Client-Werte. Der service_role-/secret-Schlüssel gehört NIE hierher (der Build bricht dann ab).
APP_ENV=beta
HUSORA_PUBLIC_SUPABASE_URL=https://<projekt-ref>.supabase.co
HUSORA_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
# optional: eigene API-Basis (Standard = Supabase-URL)
API_BASE_URL=
# optional: Support-Adresse in der App
# öffentliche Web-Adresse der App (für Einladungslinks in E-Mails/SMS)
HUSORA_PUBLIC_WEB_URL=
HUSORA_SUPPORT_EMAIL=
# Schutz: URL des jeweils ANDEREN Projekts – der Build verweigert, wenn beide gleich sind
HUSORA_PRODUCTION_SUPABASE_URL=
HUSORA_BETA_SUPABASE_URL=
